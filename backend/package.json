{
  "name": "zkp-authentication-backend",
  "version": "1.0.0",
  "description": "Zero Knowledge Proof Authentication Backend using Schnorr Protocol",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "jest --detectOpenHandles --runInBand",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "zero-knowledge-proof",
    "zkp",
    "schnorr-protocol",
    "cryptography",
    "authentication",
    "discrete-log"
  ],
  "author": "Cryptography & Network Security Academic Project",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true,
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}

